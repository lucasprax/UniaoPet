rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isEmailOwner(email) {
      return isSignedIn() && request.auth.token.email == email;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 4. Validation Helpers
    function isValidPost(data) {
      return data.keys().hasAll(['authorName', 'authorEmail', 'category', 'title', 'petName', 'description', 'location', 'phone', 'likes'])
        && data.authorName is string && data.authorName.size() <= 100
        && data.authorEmail is string && data.authorEmail.size() <= 100
        && data.category is string && (data.category == 'desaparecido' || data.category == 'adoção' || data.category == 'doação')
        && data.title is string && data.title.size() <= 200
        && data.petName is string && data.petName.size() <= 50
        && data.description is string && data.description.size() <= 2000
        && data.location is string && data.location.size() <= 100
        && data.phone is string && data.phone.size() <= 30
        && data.likes is int
        && data.authorEmail == request.auth.token.email;
    }

    function isValidComment(data) {
      return data.keys().hasAll(['postId', 'authorName', 'authorEmail', 'date', 'text'])
        && data.postId is string && data.postId.size() <= 128
        && data.authorName is string && data.authorName.size() <= 100
        && data.authorEmail is string && data.authorEmail.size() <= 100
        && data.date is string && data.date.size() <= 50
        && data.text is string && data.text.size() <= 1000
        && data.authorEmail == request.auth.token.email;
    }

    function isValidConversation(data) {
      return data.keys().hasAll(['title', 'category', 'lastMessage', 'date', 'petName', 'participants'])
        && data.title is string && data.title.size() <= 200
        && data.category is string && data.category.size() <= 50
        && data.lastMessage is string && data.lastMessage.size() <= 500
        && data.date is string && data.date.size() <= 50
        && data.petName is string && data.petName.size() <= 50
        && data.participants is list
        && data.participants.size() > 0
        && data.participants.size() <= 10
        && (request.auth.token.email in data.participants);
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['sender', 'text', 'timestamp'])
        && data.sender is string && data.sender.size() <= 100
        && data.text is string && data.text.size() <= 1000
        && data.timestamp is string && data.timestamp.size() <= 50
        && data.sender == request.auth.token.email;
    }

    // --- RULES FOR COLLECTIONS ---

    // Posts Collection
    match /posts/{postId} {
      allow get: if true;
      allow list: if true;
      
      allow create: if isSignedIn() 
        && isValidId(postId) 
        && isValidPost(incoming());
        
      allow update: if isSignedIn() 
        && isValidPost(incoming())
        && (
          // Case 1: Owner updates their post details (likes or text content change)
          (isEmailOwner(existing().authorEmail) && incoming().authorEmail == existing().authorEmail && incoming().id == existing().id)
          ||
          // Case 2: Someone likes/unlikes the post - only the likes field can be changed
          (incoming().diff(existing()).affectedKeys().hasOnly(['likes']))
        );
        
      allow delete: if isSignedIn() 
        && isEmailOwner(existing().authorEmail);

      // Comments Sub-collection
      match /comments/{commentId} {
        allow get: if true;
        allow list: if true;
        
        allow create: if isSignedIn() 
          && isValidId(commentId) 
          && isValidComment(incoming());
          
        allow update: if isSignedIn() 
          && isEmailOwner(existing().authorEmail) 
          && isValidComment(incoming())
          && incoming().authorEmail == existing().authorEmail
          && incoming().postId == existing().postId;
          
        allow delete: if isSignedIn() 
          && isEmailOwner(existing().authorEmail);
      }
    }

    // Conversations Collection
    match /conversations/{conversationId} {
      allow get: if isSignedIn() && (request.auth.token.email in existing().participants);
      allow list: if isSignedIn() && (request.auth.token.email in resource.data.participants);
      
      allow create: if isSignedIn() 
        && isValidId(conversationId) 
        && isValidConversation(incoming());
        
      allow update: if isSignedIn() 
        && (request.auth.token.email in existing().participants)
        && isValidConversation(incoming())
        // Ensure participants don't change arbitrarily
        && incoming().participants == existing().participants;
        
      allow delete: if isSignedIn() 
        && (request.auth.token.email in existing().participants);

      // Messages Sub-collection
      match /messages/{messageId} {
        allow get, list: if isSignedIn() 
          && (request.auth.token.email in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants);
          
        allow create: if isSignedIn() 
          && isValidId(messageId) 
          && (request.auth.token.email in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants)
          && isValidMessage(incoming());
          
        // Messages are immutable once sent
        allow update, delete: if false;
      }
    }
  }
}
