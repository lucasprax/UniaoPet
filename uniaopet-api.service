[Unit]
Description=UniãoPET API Server
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/path/to/uniaopet-api
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin
Environment=PORT=3000
Environment=NODE_ENV=production
Environment=DATA_DIR=/path/to/uniaopet-api/data
ExecStart=/usr/bin/env node dist-server/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
